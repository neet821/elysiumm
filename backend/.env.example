# 后端环境变量示例（FastAPI + MySQL/MariaDB）

# === 数据库（必填，DATABASE_URL 优先） ===
# 完整连接串示例：mysql+pymysql://<user>:<pass>@<host>:<port>/<db>
DATABASE_URL=mysql+pymysql://blue_user:CHANGE_ME_database_password@127.0.0.1:3306/blue_album
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=blue_user
DB_PASSWORD=CHANGE_ME_database_password_at_least_16_chars
DB_NAME=blue_album

# === 应用安全与鉴权 ===
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_random_application_secret_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === 服务监听 ===
# 注意：生产用 0.0.0.0，WSL 可用 127.0.0.1
HOST=0.0.0.0
PORT=8000

# === CORS ===
# 以逗号分隔多个来源，不要留空格
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === 运行日志 ===
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# === 统一音乐曲库（播放器不会接触平台 Cookie） ===
MUSIC_PROVIDER_BASE_URL=http://127.0.0.1:18181
MUSIC_PROVIDER_TIMEOUT_SECONDS=5
AUDIUS_API_BASE_URL=https://api.audius.co/v1

# === 持久存储（生产必填，必须是绝对路径） ===
PUBLIC_SYNC_STORAGE=/var/lib/blue-album/public-sync
PRIVATE_STORAGE_DIR=/var/lib/blue-album/private
ADMIN_FILES_STORAGE_DIR=/var/lib/blue-album/private/admin-files
BACKUP_OUTPUT_DIR=/home/blue-album/backups

# === 环境标识（可选） ===
# DOCKER_ENV=true 用于 Docker 镜像内自动切换
DOCKER_ENV=
# 公网视频域名校验会按顺序尝试，全部不可用时只接受系统明确解析出的公网地址。
EXTERNAL_MEDIA_DOH_URLS=https://cloudflare-dns.com/dns-query,https://dns.google/resolve

# === 单直播间（MediaMTX 只通过本机接口连接后端） ===
LIVE_MEDIAMTX_API_URL=http://127.0.0.1:9997
LIVE_RECORDING_ROOT=/srv/blue-album/live/recordings
LIVE_DISK_RESERVE_BYTES=5368709120
LIVE_OFFLINE_GRACE_SECONDS=30
LIVE_VIEWER_RETENTION_DAYS=90
LIVE_SESSION_TTL_SECONDS=120
# 当前直接 IP/HTTP 部署必须为 0；启用 HTTPS 后立即改为 1。
LIVE_COOKIE_SECURE=0
LIVE_RTMP_PUBLIC_URL=rtmp://8.148.83.28:1935/live
LIVE_PUBLIC_BASE_URL=http://8.148.83.28
