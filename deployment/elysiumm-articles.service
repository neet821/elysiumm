[Unit]
Description=Elysium Obsidian Articles Homepage
After=network.target

[Service]
Type=simple
User=personal-archive
Group=personal-archive
WorkingDirectory=/home/elysiumm/articles
EnvironmentFile=/etc/elysiumm/articles.env
ExecStart=/usr/bin/node /home/elysiumm/articles/server/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/elysiumm/articles

[Install]
WantedBy=multi-user.target
