[Unit]
Description=Elysium backend
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/services/elysium/backend-current/backend
EnvironmentFile=/etc/elysium/backend.env
Environment=PYTHONUNBUFFERED=1
Environment=UPLOAD_DIR=/srv/services/elysium/shared/uploads
Environment=PRIVATE_STORAGE_DIR=/srv/services/elysium/shared/private-storage
Environment=ADMIN_FILES_STORAGE_DIR=/srv/services/elysium/shared/private-storage/admin_files
Environment=PUBLIC_SYNC_STORAGE=/srv/services/elysium/shared/sync-storage
Environment=ARTICLE_ROOT=/srv/services/elysium/shared/sync-storage/articles
Environment=MEDIA_ROOT=/srv/services/elysium/shared/sync-storage/media
Environment=TRANSFER_STORAGE_DIR=/srv/services/elysium/shared/transfers
Environment=BACKUP_OUTPUT_DIR=/srv/services/elysium/shared/backups
Environment=MUSIC_PROVIDER_CREDENTIAL_DIR=/srv/services/elysium/shared/private-storage/music
Environment=LIVE_RECORDING_ROOT=/srv/services/elysium/shared/uploads/live-recordings
Environment=BACKEND_LOG_FILE=/var/log/elysium/backend-error.log
# Database analysis and migration are performed by deploy-production.py using
# this exact EnvironmentFile.  The service never upgrades the schema on boot.
ExecStart=/srv/services/elysium/backend-current/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
LogsDirectory=elysium
LogsDirectoryMode=0750
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/services/elysium/shared /var/log/elysium
MemoryMax=768M
TasksMax=256
UMask=0027

[Install]
WantedBy=multi-user.target
