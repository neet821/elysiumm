# 前端环境变量模板（Vite）

# 生产发布必须显式填写同源 HTTPS 地址；本地开发可留空并回退到当前来源。
VITE_API_BASE_URL=https://album.example.com
VITE_WS_BASE_URL=https://album.example.com

# 开发服务器（可选，默认 host=0.0.0.0, port=5173）
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5173

# 预览服务器（可选，默认 host=0.0.0.0, port=4173）
VITE_PREVIEW_HOST=0.0.0.0
VITE_PREVIEW_PORT=4173

# 允许访问的 host 列表（逗号分隔，不填则允许所有）
VITE_ALLOWED_HOSTS=
