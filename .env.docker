# Docker local environment template. Copy to .env, replace every CHANGE_ME,
# then run ./start-docker.sh. The launcher refuses this template unchanged.
DB_ROOT_PASSWORD=CHANGE_ME_root_password_at_least_16_chars
DB_NAME=blue_album
DB_USER=blue_album_user
DB_PASSWORD=CHANGE_ME_database_password_at_least_16_chars
SECRET_KEY=CHANGE_ME_random_application_secret_at_least_32_chars
MUSIC_PROVIDER_ADMIN_TOKEN=CHANGE_ME_random_music_provider_admin_token_at_least_24_chars
CORS_ORIGINS=http://localhost
KAVITA_PUBLIC_BASE_URL=
EXTERNAL_MEDIA_DOH_URL=https://cloudflare-dns.com/dns-query
