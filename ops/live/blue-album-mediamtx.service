[Unit]
Description=Blue Album MediaMTX live streaming
After=network-online.target blue-album.service
Wants=network-online.target

[Service]
Type=simple
User=blue-album-live
Group=blue-album-live
WorkingDirectory=/srv/blue-album/live
EnvironmentFile=-/etc/blue-album/live.env
ExecStart=/usr/local/bin/mediamtx /etc/blue-album/mediamtx.yml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=384M
TasksMax=96
UMask=0027
ReadWritePaths=/srv/blue-album/live/recordings

[Install]
WantedBy=multi-user.target
